# Server Port
PORT=5001
NODE_ENV=production

# Gemini AI API Key (required for job auditing)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yja3nwx.mongodb.net/trustbridge?retryWrites=true&w=majority

# JWT Secret Key (generate a strong random string)
JWT_SECRET=generate_a_super_secret_jwt_random_string_min_32_chars

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback

# Frontend Client URL (e.g., Vercel deployment URL)
CLIENT_URL=https://your-frontend-domain.vercel.app

# AWS Credentials (Comprehend & Rekognition for Student Identity)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Nodemailer SMTP Configuration (e.g. Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_character_app_password

# Default Admin Seed Account
ADMIN_EMAIL=admin@trustbridge.com
ADMIN_PASSWORD=Admin@StrongPassword123
